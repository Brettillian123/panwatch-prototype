  "steps": [
    {
      "instruction": "Put 1 quart of water and 1 hawthorn tea bag in a pot."
    },
    {
      "instruction": "Add the leaves of 1 small sprig of rosemary and 1 small sprig of sage."
    },
    {
      "instruction": "Add 7 thin slices of fresh ginger."
    },
    {
      "instruction": "Boil briefly."
    },
    {
      "instruction": "Take the pot off the heat and let it steep for 5 minutes.",
      "spoken": "Take the pot off the heat and let the tea steep for 5 to 10 minutes.",
      "timer": {
        "label": "Steep",
        "minutes": 5
      }
    },
    {
      "instruction": "Strain the tea to remove the solids."
    },
    {
      "instruction": "Stir in 3 tablespoons of sugar and 5 tablespoons of lemon juice."
    },
    {
      "instruction": "Let the tea cool, then serve."
    }
