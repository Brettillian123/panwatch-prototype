      "name": "water"
    },
    {
      "amount": "1",
      "name": "hawthorn tea bag"
    },
    {
      "amount": "1 small sprig",
      "name": "rosemary, leaves only"
    },
    {
      "amount": "1 small sprig",
      "name": "sage, leaves only"
    },
    {
