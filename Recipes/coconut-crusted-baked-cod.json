{
  "id": "coconut-crusted-baked-cod",
  "title": "Coconut Crusted Baked Cod",
  "category": "Fish",
  "method": "oven",
  "source": {
    "name": "Wikibooks Cookbook",
    "url": "https://en.wikibooks.org/wiki/Cookbook%3ACoconut_Crusted_Baked_Cod",
