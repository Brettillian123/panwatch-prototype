  "steps": [
    {
      "instruction": "Mince 4 cloves of garlic."
    },
    {
      "instruction": "Dice 1 large onion."
    },
    {
      "instruction": "Melt 1/4 cup of butter in a pot."
    },
    {
      "instruction": "Add the onion and garlic and sauté.",
      "spoken": "Add the onion and garlic and sauté until the onion is just beginning to brown."
    },
    {
      "instruction": "Pour in 2 to 3 cups of chicken broth and 2 to 3 cups of crushed tomatoes."
    },
    {
      "instruction": "Raise the heat to high."
    },
    {
      "instruction": "Cut 1 1/2 pounds of chicken breasts into bite-sized cubes."
    },
    {
      "instruction": "Add the chicken to the pot."
    },
    {
      "instruction": "Add 1 1/2 teaspoons of coriander, 1 teaspoon of cumin and 1/2 teaspoon of turmeric."
    },
    {
      "instruction": "Add 1/2 teaspoon each of ground fennel seeds, cinnamon, black pepper and ginger."
    },
    {
      "instruction": "Add 1/4 teaspoon each of mustard and ground cloves."
    },
    {
      "instruction": "Bring the pot to a boil."
    },
