  "serves": 4,
  "totalMinutes": 15,
  "ingredients": [
    {
      "amount": "1/3 cup",
      "name": "plain low-fat yogurt"
    },
    {
      "amount": "2 tablespoons",
      "name": "fat-reduced mayonnaise"
    },
    {
      "amount": "1 tablespoon",
      "name": "honey"
    },
    {
      "amount": "2 teaspoons",
      "name": "paprika"
    },
    {
      "amount": "2",
      "name": "ripe bananas"
    },
    {
      "amount": "12 ounces",
      "name": "lettuce mix"
    },
    {
      "amount": "2 1/2 medium",
      "name": "apples, sliced (14 ounces of sliced apples)"
    },
    {
      "amount": "3/4 cup",
      "name": "unsalted dry roasted peanuts"
    }
  ],
  "steps": [
    {
      "instruction": "Whisk 1/3 cup of plain low-fat yogurt and 2 tablespoons of mayonnaise together."
    },
    {
      "instruction": "Whisk in 1 tablespoon of honey and 2 teaspoons of paprika."
    },
    {
      "instruction": "Slice 2 ripe bananas."
    },
    {
      "instruction": "Place 12 ounces of lettuce mix in a large salad bowl."
    },
    {
      "instruction": "Add the bananas, 2 1/2 sliced apples and 3/4 cup of unsalted peanuts."
    },
    {
      "instruction": "Pour the dressing over the salad and toss."
    }
  ]
