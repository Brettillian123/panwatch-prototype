{
  "id": "irish-potato-casserole",
  "title": "Irish Potato Casserole",
  "category": "Vegetables",
  "method": "oven",
  "source": {
    "name": "based.cooking",
    "url": "https://based.cooking/irish-potato-casserole/",
    "credit": "based.cooking contributor joel-maxuel"
  },
  "serves": 6,
  "totalMinutes": 60,
  "ingredients": [
    {
      "amount": "2 cups",
      "name": "potatoes, peeled and shredded"
    },
    {
      "amount": "1/2 cup",
      "name": "butter, melted"
    },
    {
      "amount": "2",
      "name": "eggs, beaten"
    },
    {
      "amount": "1 teaspoon",
      "name": "onion, minced"
    },
    {
      "amount": "1 teaspoon",
      "name": "salt"
    },
    {
      "amount": "1/4 teaspoon",
      "name": "paprika"
    },
    {
      "amount": "1/2 cup",
      "name": "milk"
    },
    {
      "amount": "1/2 cup",
      "name": "sharp cheddar cheese, shredded"
    }
  ],
  "steps": [
    {
      "instruction": "Preheat the oven to 350 °F."
    },
    {
      "instruction": "Butter a 1 1/2-quart baking dish."
    },
    {
      "instruction": "Mix 2 cups of shredded potatoes, 1/2 cup of melted butter and 2 eggs in a bowl."
    },
    {
      "instruction": "Mix in 1 teaspoon of minced onion, 1 teaspoon of salt and 1/4 teaspoon of paprika."
    },
    {
      "instruction": "Place the potato mixture in the prepared baking dish."
    },
    {
      "instruction": "Pour 1/2 cup of milk over the top."
    },
    {
      "instruction": "Bake in the preheated oven for 40 minutes.",
      "timer": {
        "label": "Bake",
        "minutes": 40
      }
    },
    {
      "instruction": "Sprinkle 1/2 cup of shredded cheddar cheese over the top."
    },
    {
      "instruction": "Return the dish to the oven until the cheese melts and is slightly browned."
    }
  ]
}
