{
  "id": "chickpea-moi-moi",
  "title": "Chickpea Moi Moi",
  "category": "Beans and lentils",
  "method": "pot",
  "source": {
    "name": "Wikibooks Cookbook",
    "url": "https://en.wikibooks.org/wiki/Cookbook%3AChickpea_Moi_Moi"
