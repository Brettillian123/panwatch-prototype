  "steps": [
    {
      "instruction": "Trim all the fat from 2 pounds of stew beef."
    },
    {
      "instruction": "Put the beef, 5 carrots and 1 chopped onion in a slow cooker."
    },
    {
      "instruction": "Add 3 sliced celery stalks and 1 large can of tomatoes."
    },
    {
      "instruction": "Add 1/2 cup of quick-cooking tapioca, 1 whole clove and 2 bay leaves."
    },
    {
      "instruction": "Add salt and pepper to taste."
    },
    {
      "instruction": "Mix everything thoroughly."
    },
    {
      "instruction": "Cover and cook on high for 5 hours, or on low for twelve hours.",
      "spoken": "Cover and cook on high for 5 to six hours, or on low for twelve hours.",
      "timer": {
        "label": "Cook",
        "minutes": 300
