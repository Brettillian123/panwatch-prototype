  "steps": [
    {
      "instruction": "Heat the oven to 325 °F."
    },
    {
      "instruction": "Beat 3/4 cup of sugar and 1 egg until smooth."
    },
    {
      "instruction": "Beat in 1/4 cup of flour and 1 1/4 teaspoons of baking powder."
    },
    {
      "instruction": "Beat in 1 pinch of salt and 1 teaspoon of vanilla."
    },
    {
      "instruction": "Stir in 1 cup of chopped walnuts or hickory nuts and 1/2 cup of chopped apples."
    },
    {
      "instruction": "Pour into a greased Dutch oven or 9 by 9-inch pan."
