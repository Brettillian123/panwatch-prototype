  "totalMinutes": 10,
  "ingredients": [
    {
      "amount": "2-3",
      "name": "avocados"
    },
    {
      "amount": "1 teaspoon",
      "name": "lemon juice"
    },
    {
      "amount": "to taste",
      "name": "paprika"
    },
    {
      "amount": "to taste",
      "name": "salt"
    }
  ],
  "steps": [
    {
      "instruction": "Scoop the flesh out of 2 to 3 avocados, leaving the peel and pit."
    },
    {
      "instruction": "Mash the avocado with 1 teaspoon of lemon juice, paprika and salt to taste."
    },
    {
      "instruction": "Let the relish rest for 5 minutes before serving.",
      "spoken": "Let the relish rest for 5 to ten minutes before serving.",
      "timer": {
        "label": "Rest",
        "minutes": 5
      }
    }
  ]
}
