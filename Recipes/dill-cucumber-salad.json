  "totalMinutes": 70,
  "ingredients": [
    {
      "amount": "1/2 cup",
      "name": "reduced-fat sour cream"
    },
    {
      "amount": "2 tablespoons",
      "name": "cider vinegar"
    },
    {
      "amount": "1 teaspoon",
      "name": "sugar"
    },
    {
      "amount": "3/4 teaspoon",
      "name": "garlic powder"
    },
    {
      "amount": "3/4 teaspoon",
      "name": "dill weed"
    },
    {
      "amount": "1/2 teaspoon",
      "name": "salt"
    },
    {
      "amount": "3 medium",
      "name": "cucumbers, sliced"
    },
    {
      "amount": "1/2 cup",
      "name": "onion, sliced"
    }
  ],
  "steps": [
    {
      "instruction": "In a bowl, mix 1/2 cup of sour cream and 2 tablespoons of cider vinegar."
    },
    {
      "instruction": "Mix in 1 teaspoon of sugar, 3/4 teaspoon of garlic powder and 3/4 teaspoon of dill weed."
    },
    {
      "instruction": "Mix in 1/2 teaspoon of salt."
    },
    {
      "instruction": "Add 3 sliced cucumbers and 1/2 cup of sliced onion."
    },
    {
      "instruction": "Toss to coat the vegetables."
    },
    {
      "instruction": "Cover the bowl and refrigerate for at least 1 hour.",
      "timer": {
        "label": "Chill",
        "minutes": 60
      }
    },
    {
      "instruction": "Serve the salad with a slotted spoon."
    }
  ]
