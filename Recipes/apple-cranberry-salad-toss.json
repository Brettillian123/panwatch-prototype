      "name": "lettuce (about 10 cups)"
    },
    {
      "amount": "2 medium",
      "name": "apples, sliced"
    },
    {
      "amount": "1/2 cup",
      "name": "walnuts, chopped"
    },
    {
      "amount": "1 cup",
      "name": "dried cranberries"
    },
    {
