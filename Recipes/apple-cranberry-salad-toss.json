  ],
  "steps": [
    {
      "instruction": "Put 1 medium head of lettuce (about 10 cups) in a large bowl."
    },
    {
      "instruction": "Add 2 sliced medium apples and 1/2 cup of chopped walnuts."
    },
    {
      "instruction": "Add 1 cup of dried cranberries and 1/2 cup of sliced green onions."
    },
    {
      "instruction": "Toss everything together in the bowl."
    },
    {
      "instruction": "Add 3/4 cup of vinaigrette dressing."
    },
    {
      "instruction": "Toss to coat."
    },
    {
      "instruction": "Serve right away."
    }
