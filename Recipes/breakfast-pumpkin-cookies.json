  "steps": [
    {
      "instruction": "Heat the oven to 400 °F."
    },
    {
      "instruction": "Mix 1 3/4 cups of pumpkin and 1 1/2 cups of brown sugar thoroughly."
    },
    {
      "instruction": "Mix in 2 eggs and 1/2 cup of vegetable oil thoroughly."
    },
    {
      "instruction": "Blend 1 1/2 cups flour, 1 1/4 cups whole wheat flour and 1 tablespoon baking powder."
    },
    {
      "instruction": "Blend in 2 teaspoons of cinnamon and 1 teaspoon of nutmeg."
    },
    {
      "instruction": "Blend in 1/2 teaspoon of salt and 1/4 teaspoon of ground ginger."
    },
    {
      "instruction": "Add the dry mixture to the pumpkin mixture."
    },
    {
      "instruction": "Add 1 cup of raisins and 1 cup of chopped walnuts."
    },
    {
      "instruction": "Drop the dough by teaspoonfuls onto a greased cookie sheet."
    },
    {
      "instruction": "Bake for 10 minutes, until golden brown. Makes 48 cookies.",
