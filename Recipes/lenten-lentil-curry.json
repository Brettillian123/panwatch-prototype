  "steps": [
    {
      "instruction": "Rinse 7 ounces of green lentils well and drain them."
    },
    {
      "instruction": "Put the lentils in a pot with 4 cups of water."
    },
    {
      "instruction": "Bring the lentils to a boil."
    },
    {
      "instruction": "Boil gently for 15 minutes.",
      "spoken": "Boil gently for 15 to twenty minutes.",
      "timer": {
        "label": "Boil",
        "minutes": 15
      }
    },
    {
      "instruction": "Drain the lentils."
    },
    {
      "instruction": "Add 1 3/4 ounces of vermicelli to the pot."
    },
    {
      "instruction": "Add 1 teaspoon of curry powder and 1/2 teaspoon of paprika."
    },
    {
      "instruction": "Add 1/2 teaspoon of cinnamon and 1/2 teaspoon of ground sumac."
    },
    {
      "instruction": "Add 1 1/2 to 2 teaspoons of salt and a little ground black pepper."
    },
    {
      "instruction": "Add 2 cups of boiling water."
    },
