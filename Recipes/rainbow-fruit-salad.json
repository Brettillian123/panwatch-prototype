{
  "id": "rainbow-fruit-salad",
  "title": "Rainbow Fruit Salad",
  "category": "Salads",
  "method": "noHeat",
  "source": {
    "name": "NHLBI (NIH)",
    "url": "https://www.nhlbi.nih.gov/health/heart-healthy-living/healthy-foods/healthy-eating-recipes/rainbow-fruit-salad",
    "credit": "NHLBI, NIH; Stay Young At Heart"
  },
  "serves": 12,
  "totalMinutes": 20,
  "ingredients": [
    {
      "amount": "1 large",
      "name": "mango, peeled and diced"
    },
    {
      "amount": "2 cups",
      "name": "fresh blueberries"
    },
    {
      "amount": "2",
      "name": "bananas, sliced"
    },
    {
      "amount": "2 cups",
      "name": "fresh strawberries, halved"
    },
    {
      "amount": "2 cups",
      "name": "seedless grapes"
    },
    {
      "amount": "2",
      "name": "nectarines, peeled and sliced"
    },
    {
      "amount": "1",
      "name": "kiwi fruit, peeled and sliced"
    },
    {
      "amount": "1/3 cup",
      "name": "unsweetened orange juice"
    },
    {
      "amount": "2 tablespoons",
      "name": "lemon juice"
    },
    {
      "amount": "1 1/2 tablespoons",
      "name": "honey"
    },
    {
      "amount": "1/4 teaspoon",
      "name": "ground ginger"
    },
    {
      "amount": "1 dash",
      "name": "nutmeg"
    }
  ],
  "steps": [
    {
      "instruction": "Put 1 large diced mango, 2 cups of blueberries and 2 sliced bananas in a large bowl."
    },
    {
      "instruction": "Add 2 cups of halved strawberries and 2 cups of seedless grapes."
    },
    {
      "instruction": "Add 2 sliced nectarines and 1 sliced kiwi fruit."
    },
    {
      "instruction": "Mix the fruit together in the bowl."
    },
    {
      "instruction": "Mix 1/3 cup of orange juice and 2 tablespoons of lemon juice in a small bowl."
    },
    {
      "instruction": "Stir in 1 1/2 tablespoons of honey, 1/4 teaspoon of ground ginger and 1 dash of nutmeg."
    },
    {
      "instruction": "Just before serving, pour the sauce over the fruit."
    }
  ]
}
