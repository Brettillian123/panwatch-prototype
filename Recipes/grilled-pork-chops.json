    {
      "amount": "2 cups",
      "name": "apple cider vinegar, heated"
    },
    {
      "amount": "4 sprigs",
      "name": "fresh rosemary, finely chopped"
    },
    {
      "amount": "10 sprigs",
      "name": "fresh thyme, finely chopped"
    },
    {
      "amount": "1 1/2 tablespoons",
      "name": "cayenne pepper"
    },
    {
      "amount": "2 tablespoons",
      "name": "garlic, minced"
    },
    {
      "amount": "2 pounds",
      "name": "ice"
    },
    {
      "amount": "4",
      "name": "thick-cut pork rib chops"
    },
    {
      "amount": "2 tablespoons",
      "name": "black peppercorns, cracked"
    },
    {
      "amount": "1 tablespoon",
      "name": "smoked paprika"
    },
    {
