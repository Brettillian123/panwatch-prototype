  "steps": [
    {
      "instruction": "Mix 1/2 cup of oil, 4 ounces of melted chocolate and 2 cups of sugar."
    },
    {
      "instruction": "Blend in 4 eggs, one at a time, until well mixed."
    },
    {
      "instruction": "Add 2 teaspoons of vanilla extract."
    },
    {
      "instruction": "Stir in 2 cups of flour, 2 teaspoons of baking powder and 1/2 teaspoon of salt."
    },
    {
      "instruction": "Chill the dough overnight, or at least several hours."
    },
    {
      "instruction": "Heat the oven to 350 °F."
    },
    {
      "instruction": "Drop teaspoonfuls of dough into 1 cup of confectioners' sugar."
    },
    {
      "instruction": "Roll the dough in the sugar and shape it into balls."
    },
    {
      "instruction": "Place the balls about 2 inches apart on a greased baking sheet."
    },
    {
      "instruction": "Bake for 10 minutes.",
      "spoken": "Bake for 10 to 12 minutes.",
