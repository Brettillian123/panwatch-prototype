  "steps": [
    {
      "instruction": "Heat the oven to 350 °F."
    },
    {
      "instruction": "Melt 1/2 cup of margarine in a pot."
    },
    {
      "instruction": "Stir in 1/2 cup of flour."
    },
    {
      "instruction": "Add 1 cup of water, 1 tablespoon of chicken soup powder and 1 cup of mayonnaise."
    },
    {
      "instruction": "Stir until the sauce thickens."
    },
    {
      "instruction": "Take the pot off the heat."
    },
    {
      "instruction": "Add 3 pounds of thawed chopped broccoli and 2 tablespoons of onion soup mix."
    },
    {
      "instruction": "Add 6 eggs, 1/2 teaspoon of pepper and 4 teaspoons of pine nuts."
    },
    {
      "instruction": "Pour the mixture into a 9 by 13 inch pan."
