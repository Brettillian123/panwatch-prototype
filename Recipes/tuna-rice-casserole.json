  "steps": [
    {
      "instruction": "Heat the oven to 400 °F."
    },
    {
      "instruction": "Mix 2 cans of tuna, 1 package of cooked peas and 3 cups of rice in a large bowl."
    },
    {
      "instruction": "In another large bowl, mix 1 can of cheddar cheese soup and 3/4 cup of water."
    },
    {
      "instruction": "Add the soup mixture to the tuna mixture."
    },
    {
      "instruction": "Place the mixture in a greased casserole dish."
    },
