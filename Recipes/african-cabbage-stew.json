  "steps": [
    {
      "instruction": "Heat 2 tablespoons of avocado oil in a large saucepan over medium heat."
    },
    {
      "instruction": "Add 2 medium chopped onions.",
      "spoken": "Add the onions and cook until tender, about 2 minutes.",
