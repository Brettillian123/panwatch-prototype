    },
    {
      "instruction": "Add 2 eggs to the sugar and butter, one at a time."
    },
    {
      "instruction": "Beat in 1 can of pumpkin."
    },
    {
      "instruction": "Whisk in the flour mixture."
    },
    {
      "instruction": "Pour the batter into the loaf pans."
