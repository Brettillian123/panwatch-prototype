  "steps": [
    {
      "instruction": "Grease 2 loaf pans or line them with parchment paper."
    },
    {
      "instruction": "Preheat the oven to 325 °F."
    },
    {
      "instruction": "Mix 2 cups of flour, 1/2 teaspoon of salt and 1/2 teaspoon of baking powder.",
