  "steps": [
    {
      "instruction": "Heat the oven to 375 °F."
    },
    {
      "instruction": "Add 2 cups of chopped brioche bread to a deep roasting pan."
    },
    {
      "instruction": "Add 1/2 cup of chopped walnuts and 1/4 cup of chopped dried apples."
    },
    {
      "instruction": "Add 1/4 cup of diced red onion, 1/4 cup of diced celery and 2 cloves of minced garlic."
    },
    {
      "instruction": "Add 1/4 cup of honey and 1/4 cup of butter cut into small cubes."
    },
    {
      "instruction": "Add 2 tablespoons of brown sugar and 1/2 teaspoon of dried rubbed sage."
    },
    {
      "instruction": "Season with salt and pepper."
    },
    {
      "instruction": "Press everything into a loose, flat layer."
    },
    {
      "instruction": "Bake for 25 minutes.",
