      "name": "low-sodium beef bouillon"
    },
    {
      "amount": "2 cups",
      "name": "hot water"
    },
    {
      "amount": "1 tablespoon",
      "name": "orange juice"
    },
    {
      "amount": "1/4 teaspoon",
      "name": "allspice"
    },
    {
      "amount": "1/8 teaspoon",
      "name": "black pepper"
    },
    {
      "amount": "1/2 cup",
      "name": "onion, chopped"
    },
    {
      "amount": "2 tablespoons",
      "name": "water"
    },
    {
      "amount": "2 1/2 pounds",
      "name": "boneless beef chuck roast"
    }
  ],
  "steps": [
    {
      "instruction": "Put 1 piece of beef bouillon in 2 cups of hot water in a small bowl."
    },
    {
      "instruction": "Stir until the bouillon dissolves.",
      "spoken": "Stir until the bouillon dissolves. This makes 2 cups of beef broth."
    },
    {
      "instruction": "Mix the broth and 1 tablespoon of orange juice in a medium bowl."
    },
    {
      "instruction": "Stir in 1/4 teaspoon of allspice and 1/8 teaspoon of black pepper."
    },
    {
      "instruction": "Peel and chop 1 onion to make 1/2 cup."
    },
    {
      "instruction": "Put 2 tablespoons of water in a large skillet and heat on medium."
    },
    {
      "instruction": "Add the onion and simmer until tender."
    },
    {
      "instruction": "Add 2 1/2 pounds of beef chuck roast to the skillet."
    },
    {
      "instruction": "Brown the roast on all sides."
    },
    {
      "instruction": "Pour the broth mixture over the meat in the skillet."
    },
    {
      "instruction": "Cover and simmer for 2 hours.",
      "timer": {
        "label": "Simmer",
        "minutes": 120
      }
    }
  ]
