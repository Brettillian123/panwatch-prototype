      "instruction": "Fry 1 chopped onion in a skillet with 1 dash of oil.",
      "spoken": "Fry 1 chopped onion in a skillet with 1 dash of oil until the onion is soft and clear."
    },
    {
      "instruction": "Add 2 pounds of ground beef to the onion."
    },
    {
      "instruction": "Cook, breaking up the meat, until it is browned."
    },
    {
      "instruction": "Put the meat mixture in a large stockpot."
    },
    {
      "instruction": "Add 36 ounces of stewed tomatoes, 16 ounces of corn and 8 ounces of peas."
    },
    {
      "instruction": "Add 6 chopped celery stalks and 6 cubed potatoes."
    },
    {
      "instruction": "Add 8 ounces of beef broth, 8 ounces of chicken broth and 1 cup of rice."
    },
    {
      "instruction": "Add 2 tablespoons of salt and 2 tablespoons of pepper."
    },
    {
      "instruction": "Add about 2 cups of water, enough to cover everything by a few inches."
