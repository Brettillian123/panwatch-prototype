  "steps": [
    {
      "instruction": "Heat the oven to 300 °F."
    },
    {
      "instruction": "In a large bowl, blend 1/2 pound of margarine and 2 cups of grated cheddar."
    },
    {
      "instruction": "Add 2 cups of flour, 1 teaspoon of salt and 3/4 teaspoon of cayenne pepper."
    },
    {
      "instruction": "Stir in 2 cups of puffed rice cereal, mixing thoroughly."
    },
    {
      "instruction": "Shape the dough into small balls."
    },
    {
      "instruction": "Flatten each ball with a fork."
    },
    {
      "instruction": "Place each cookie onto an ungreased cookie sheet."
    },
    {
      "instruction": "Bake for 20 minutes.",
