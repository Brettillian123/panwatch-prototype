  "steps": [
    {
      "instruction": "Heat 3 tablespoons of canola oil in a pan over medium-high heat."
    },
    {
      "instruction": "Add 1 cup of uncooked white rice to the oil."
    },
    {
      "instruction": "Fry the rice until golden brown, stirring often."
    },
    {
      "instruction": "Add 1/2 chopped onion and 1/2 chopped green pepper."
    },
    {
      "instruction": "Cook until slightly softened."
    },
    {
      "instruction": "Add 1 cup of chopped tomatoes, 1 teaspoon of salt and 1/2 teaspoon of cumin."
    },
    {
      "instruction": "Add 2 cups of water."
    },
    {
      "instruction": "Cover and cook on low heat for 20 minutes.",
