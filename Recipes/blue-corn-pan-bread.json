  "steps": [
    {
      "instruction": "Preheat the oven to 300 °F."
    },
    {
      "instruction": "Line an 8-inch square cake pan with foil."
    },
    {
      "instruction": "Bring 3 cups of water to a boil in a large pot."
    },
    {
      "instruction": "Add 2 cups of blue cornmeal."
    },
    {
      "instruction": "Add 1 cup of yellow cornmeal."
    },
    {
      "instruction": "Add 3/4 cup of raisins."
    },
    {
      "instruction": "Add 1/2 cup of sprouted wheat."
    },
    {
      "instruction": "Add 1/3 cup of packed brown sugar."
    },
    {
      "instruction": "Stir well until the mixture is smooth."
    },
    {
      "instruction": "Pour the mixture into the foil-lined pan."
    },
    {
      "instruction": "Cover the pan with a piece of foil."
    },
    {
      "instruction": "Bake for 2 hours, until a toothpick in the center comes out clean.",
