  "steps": [
    {
      "instruction": "Wash 1 cup of dried beans well."
    },
    {
      "instruction": "Soak the beans in water overnight."
    },
    {
      "instruction": "In the morning, add 2 cups of water to the beans."
    },
    {
      "instruction": "Simmer the beans until tender."
    },
    {
      "instruction": "Fry 2 ounces of diced salt pork until crisp."
    },
    {
      "instruction": "Take the salt pork out of the fat and add it to the beans."
    },
    {
      "instruction": "Brown 1/4 cup of chopped onion in the salt pork fat."
    },
    {
      "instruction": "Mix the onion, 1 cup of cooked rice and the beans together."
    },
    {
      "instruction": "Add salt and pepper to taste."
    },
