  "steps": [
    {
      "instruction": "Add 1 1/4 pounds of tomatoes and 1 can of canned tomatoes to a food processor."
    },
    {
      "instruction": "Add 1 green onion, 1 red onion, 1 jalapeno pepper and 1 clove of garlic."
    },
    {
      "instruction": "Add 1 handful of fresh cilantro."
    },
    {
      "instruction": "Add the juice of 1/2 lime, 1 chili pepper and 1/4 teaspoon of cumin, if you like."
    },
    {
      "instruction": "Pulse in short bursts until the salsa is as chunky as you like."
    },
    {
      "instruction": "Refrigerate the salsa until you serve it, for up to 1 week.",
      "spoken": "Refrigerate the salsa until you serve it. It keeps for up to 1 week. This makes about 14 servings."
    }
  ]
