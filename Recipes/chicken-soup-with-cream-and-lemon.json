  "steps": [
    {
      "instruction": "Heat 2 tablespoons of olive oil in a large pot over medium-low heat."
    },
    {
      "instruction": "Add 1 tablespoon of minced garlic and 1 medium onion, finely diced."
    },
    {
      "instruction": "Add 4 ribs of chopped celery and 1/2 large carrot, finely diced."
    },
    {
      "instruction": "Add a pinch of salt."
    },
    {
      "instruction": "Cook until the onion is soft and clear.",
      "spoken": "Cook until the onion is soft and clear. Try not to let it brown if you want a lighter-colored soup."
    },
    {
      "instruction": "Add 2 cups of shredded cooked chicken and 3 cups of chicken broth."
    },
    {
      "instruction": "Add 1/4 cup of lemon juice and 2 tablespoons of finely grated lemon zest."
    },
    {
      "instruction": "Add 1/2 cup of heavy cream."
    },
    {
      "instruction": "Add 12 sprigs of thyme, 5 sprigs of rosemary and 3 bay leaves."
    },
    {
      "instruction": "Bring the soup to a boil over medium-high heat."
    },
    {
      "instruction": "Lower the heat, cover, and simmer for 30 minutes.",
      "timer": {
        "label": "Simmer",
        "minutes": 30
      }
    },
    {
      "instruction": "Take out the herbs and bay leaves, if you like."
    },
    {
      "instruction": "Season with kosher salt and pepper to taste."
    }
  ]
