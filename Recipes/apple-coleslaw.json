{
  "id": "apple-coleslaw",
  "title": "Apple Coleslaw",
  "category": "Salads",
  "method": "noHeat",
  "source": {
    "name": "USDA MyPlate Kitchen",
    "url": "https://www.myplate.gov/recipes/apple-coleslaw",
    "credit": "Pennsylvania Nutrition Education Network"
  },
  "serves": 4,
  "totalMinutes": 25,
  "ingredients": [
    {
      "amount": "2 cups",
      "name": "cabbage, shredded"
    },
    {
      "amount": "1 medium",
      "name": "carrot, grated"
    },
    {
      "amount": "1/2 medium",
      "name": "green pepper, chopped"
    },
    {
      "amount": "1 medium",
      "name": "apple, chopped"
    },
    {
      "amount": "5 tablespoons",
      "name": "low-fat yogurt"
    },
    {
      "amount": "1 tablespoon",
      "name": "low-fat mayonnaise"
    },
    {
      "amount": "1 teaspoon",
      "name": "lemon juice"
    },
    {
      "amount": "1/4 teaspoon",
      "name": "dill weed"
    },
    {
      "amount": "to taste",
      "name": "salt and pepper"
    }
  ],
  "steps": [
    {
      "instruction": "Wash the cabbage."
    },
    {
      "instruction": "Cut the cabbage into fine shreds, until you have 2 cups."
    },
    {
      "instruction": "Peel 1 medium carrot."
    },
    {
      "instruction": "Grate the carrot with a grater."
    },
    {
      "instruction": "Chop 1/2 of a medium green pepper into small pieces."
    },
    {
      "instruction": "Remove the core of 1 medium apple, and chop the apple."
    },
    {
      "instruction": "Put the cabbage, carrot, green pepper and apple in a large bowl and stir."
    },
    {
      "instruction": "Stir 5 tablespoons of yogurt, 1 tablespoon of mayonnaise and 1 teaspoon of lemon juice."
    },
    {
      "instruction": "Stir in 1/4 teaspoon of dill weed to make a dressing."
    },
    {
      "instruction": "Pour the dressing over the salad and toss to mix."
    },
    {
      "instruction": "Add salt and pepper to taste."
    }
  ]
}
