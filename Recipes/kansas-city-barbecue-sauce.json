  "steps": [
    {
      "instruction": "Put 4 cups of ketchup and 3/4 cup of molasses in a large saucepan."
    },
    {
      "instruction": "Add 1/4 cup of Worcestershire sauce and 1/4 cup of soy sauce."
    },
    {
      "instruction": "Add 1/4 cup of cider vinegar and 2 tablespoons of cayenne pepper."
    },
    {
      "instruction": "Bring the sauce to a boil over high heat."
    },
    {
      "instruction": "Cook for 15 minutes, stirring often.",
