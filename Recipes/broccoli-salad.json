  "steps": [
    {
      "instruction": "Put 6 cups of broccoli, 1 cup of raisins and 1 diced red onion in a medium bowl."
    },
    {
      "instruction": "Add 2 tablespoons of sugar, 2 tablespoons of lemon juice and 3/4 cup of mayonnaise."
    },
    {
      "instruction": "Add 8 slices of cooked, crumbled bacon, if you like."
    },
    {
      "instruction": "Mix everything well."
    },
