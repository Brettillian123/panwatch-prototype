  "steps": [
    {
      "instruction": "Heat the oven to 350 °F."
    },
    {
      "instruction": "Cook 1 package of macaroni by the package directions."
    },
    {
      "instruction": "Drain the macaroni."
    },
    {
      "instruction": "In a large bowl, add 1/2 pound of grated cheddar cheese and the macaroni."
    },
    {
      "instruction": "Add 2/3 cup of milk and 1/2 teaspoon of dry mustard."
    },
    {
      "instruction": "Add 1/2 cup of chopped onion, 1 can of cream of celery soup and 1 teaspoon of salt."
    },
    {
      "instruction": "Mix everything together."
    },
    {
      "instruction": "Add 1 can of salmon and 1 bag of frozen peas."
    },
    {
      "instruction": "Place the mixture in a greased 9 by 13 inch pan."
    },
    {
      "instruction": "Cover the mixture with 1 cup of bread crumbs."
    },
    {
      "instruction": "Drizzle 2 tablespoons of melted butter over the top."
    },
    {
      "instruction": "Bake for 45 minutes.",
